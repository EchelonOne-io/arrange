{
  "name": "home-screen-organizer",
  "productName": "Home Screen Organizer",
  "version": "1.0.0",
  "description": "Rearrange your iPhone or iPad Home Screen from your computer over USB.",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:mac:signed": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-hso-notary} electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "appium-ios-device": "3.1.26"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.homescreenorganizer.desktop",
    "productName": "Home Screen Organizer",
    "files": ["src/**", "renderer/**", "package.json", "!node_modules/sharp/**", "!node_modules/@img/**"],
    "directories": { "buildResources": "build", "output": "dist" },
    "mac": {
      "category": "public.app-category.utilities",
      "artifactName": "Home-Screen-Organizer-${version}.${ext}",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": { "title": "Home Screen Organizer" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
