{
  "name": "ipad-organizer",
  "productName": "iPad Organizer",
  "version": "1.0.0",
  "description": "Rearrange your iPad Home Screen from your computer over USB.",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "appium-ios-device": "3.1.26"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.ipadorganizer.desktop",
    "productName": "iPad Organizer",
    "files": ["src/**", "renderer/**", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png"
    },
    "dmg": { "title": "iPad Organizer" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
